{
  "name": "typesploit",
  "version": "0.1.0",
  "description": "TypeScript client for Metasploit RPC, port of pymetasploit3",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf lib",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@types/node-fetch": "^2.6.12",
    "msgpackr": "^1.11.2",
    "node-fetch": "^2.7.0"
  },
  "bin": {
    "tsmsfrpc": "bin/tsmsfrpc.js",
    "tsmsfconsole": "bin/tsmsfconsole.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^14.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "typescript": "^4.5.0"
  }
}
